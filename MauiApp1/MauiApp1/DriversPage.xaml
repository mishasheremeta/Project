<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:viewmodels="clr-namespace:MauiApp1.Resources.ViewModels"
             xmlns:models="clr-namespace:logic.Models;assembly=logic"
            x:DataType="viewmodels:CargosViewModel"
             x:Class="MauiApp1.DriversPage"
             Title="Водії">


    <CollectionView Margin="16" ItemsSource="{Binding Drivers}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Driver">
                    <Frame Margin="0,6" Padding="14" CornerRadius="10">
                        <StackLayout>
                            <Label Text="{Binding Fullname}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Phone}" TextColor="Gray" />
                            <Label Text="{Binding Transport.Model, StringFormat='Авто: {0}'}" />
                            <Label Text="{Binding Status}" TextColor="Orange" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage>