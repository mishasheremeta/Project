<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TransportsPage"
             Title="Транспорт">

    <Grid Padding="16" RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Transports}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6" Padding="14" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout>
                                <Label Text="{Binding Model}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding GosNumber, StringFormat='Номер: {0}'}" TextColor="Gray" />
                                <Label Text="{Binding IdTrakera, StringFormat='ID трекера: {0}'}" TextColor="Gray" />
                            </StackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding Status}"
                                   TextColor="Orange"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
